{{ 'bundleflow-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'bundleflow-widget.js' | asset_url }}" defer></script>
<section class="bundleflow-widget" data-bundleflow data-api-url="https://bundleflow-teazys.vercel.app/api/storefront/bundles" data-current-product-id="{{ product.id }}" data-current-product-handle="{{ product.handle | escape }}" data-button-label="{{ block.settings.button_label | escape }}" data-default-offer="{{ block.settings.default_offer }}" data-show-button="{{ block.settings.show_button }}" style="--bf-accent:{{ block.settings.accent }};--bf-text:{{ block.settings.text_color }};--bf-card:{{ block.settings.card_background }};--bf-selected:{{ block.settings.selected_background }};--bf-badge:{{ block.settings.badge_background }};--bf-gift:{{ block.settings.gift_background }};--bf-border:{{ block.settings.border_color }};--bf-button:{{ block.settings.button_color }};--bf-radius:{{ block.settings.corner_radius }}px;--bf-border-width:{{ block.settings.border_width }}px;--bf-heading-size:{{ block.settings.heading_size }}px;--bf-card-padding:{{ block.settings.card_padding }}px;" {{ block.shopify_attributes }}>
  <div class="bundleflow-widget__header"><h2>{{ block.settings.heading | escape }}</h2></div>
  <div class="bundleflow-widget__loading" role="status">Loading bundles…</div>
  <div class="bundleflow-widget__list" data-bundle-list></div>
  <div class="bundleflow-widget__message" data-bundle-message aria-live="polite"></div>
</section>
{% schema %}
{"name":"Thanh Sang Bundle","target":"section","settings":[
{"type":"text","id":"heading","label":"Heading","default":"BUNDLE & SAVE"},
{"type":"text","id":"button_label","label":"Button label","default":"ADD SELECTED BUNDLE"},
{"type":"header","content":"Layout"},
{"type":"range","id":"default_offer","label":"Default selected offer","min":1,"max":3,"step":1,"default":1},
{"type":"range","id":"corner_radius","label":"Corner radius","min":0,"max":24,"step":1,"unit":"px","default":14},
{"type":"range","id":"border_width","label":"Selected border width","min":1,"max":4,"step":1,"unit":"px","default":2},
{"type":"range","id":"card_padding","label":"Card spacing","min":8,"max":24,"step":1,"unit":"px","default":14},
{"type":"range","id":"heading_size","label":"Heading size","min":11,"max":22,"step":1,"unit":"px","default":14},
{"type":"header","content":"Colors"},
{"type":"color","id":"accent","label":"Selected radio","default":"#111111"},
{"type":"color","id":"text_color","label":"Text","default":"#111111"},
{"type":"color","id":"card_background","label":"Unselected card","default":"#eeeeee"},
{"type":"color","id":"selected_background","label":"Selected card","default":"#ffffff"},
{"type":"color","id":"border_color","label":"Border","default":"#111111"},
{"type":"color","id":"badge_background","label":"Savings badge","default":"#e4e4e4"},
{"type":"color","id":"gift_background","label":"Gift row","default":"#bcbcbc"},
{"type":"color","id":"button_color","label":"Add button","default":"#111111"},
{"type":"header","content":"Cart button"},
{"type":"checkbox","id":"show_button","label":"Show add to cart button","default":true}
]}
{% endschema %}
