# Required: the installed app's client ID and secret (server only).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS URL; also set application_url in shopify.app.production.toml.
SHOPIFY_APP_URL=https://your-app.example.com
# Single-store installation. Never use a merchant-supplied query as this value.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
# Optional: same-app, same-shop Admin token. Otherwise use client credentials
# (the app and store must belong to the same Shopify organization).
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Optional legacy fallback for the public client ID; never put a secret here.
NEXT_PUBLIC_SHOPIFY_API_KEY=
